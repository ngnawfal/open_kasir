# Example Environment Variables for Go Backend
# Copy this file to .env (or export manually) and adjust as needed

# API Settings
PORT=8000

# Database location
DB_PATH=data/kasir.db

# Static uploads directory
UPLOAD_DIR=uploads

# JWT secret
JWT_SECRET=ubah-secret-anda

# CORS origins (comma-separated)
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
